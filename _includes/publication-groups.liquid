{% assign publication_areas = 'Spiking Neural Networks,Embodied Intelligence' | split: ',' %}
<div class="publications">
  {% for publication_area in publication_areas %}
    {% assign area_slug = publication_area | slugify %}
    {% assign publication_query = '@*[research_area=' | append: area_slug %}
    {% if include.selected_only %}
      {% assign publication_query = publication_query | append: '&&selected=true' %}
    {% endif %}
    <h3>{{ publication_area }}</h3>
    {% assign accepted_query = publication_query | append: '&&publication_status=accepted]' %}
    {% assign arxiv_query = publication_query | append: '&&publication_status=arxiv]' %}
    {% capture accepted_count %}{% bibliography_count --group_by none --query {{ accepted_query }} %}{% endcapture %}
    {% capture arxiv_count %}{% bibliography_count --group_by none --query {{ arxiv_query }} %}{% endcapture %}
    {% assign accepted_count = accepted_count | strip %}
    {% assign arxiv_count = arxiv_count | strip %}
    {% if accepted_count == '0' and arxiv_count == '0' %}
      <p>No publications listed yet.</p>
    {% else %}
      {% if accepted_count != '0' %}
        {% bibliography --group_by none --query {{ accepted_query }} %}
      {% endif %}
      {% if arxiv_count != '0' %}
        {% bibliography --group_by none --query {{ arxiv_query }} %}
      {% endif %}
    {% endif %}
  {% endfor %}
</div>
