@article{hu2026quantaspike,
  abbr          = {arXiv},
  bibtex_show   = {true},
  selected      = {true},
  title         = {QuantaSpike: Short-Window Spike-Driven Quantization for Large Language Models},
  author        = {Hu, Bang and Zhu, Guowei and Lv, Changze and Zheng, Xiaoqing and Zhang, Fengzhe and Zhang, Fan and Cao, Wei},
  year          = {2026},
  month         = {sep},
  eprint        = {2609.34259},
  archivePrefix = {arXiv},
  primaryClass  = {cs.AI},
  doi           = {10.48550/arXiv.2609.34259},
  arxiv         = {2609.34259},
  abstract      = {Large language models achieve strong performance across many tasks but rely on dense multiply-accumulate operations during inference, resulting in high energy cost. Spiking neural networks offer an event-driven alternative in which synaptic integration uses lightweight accumulation. However, spike-driven LLM inference remains difficult because outlier-heavy activations typically require long firing windows or auxiliary non-spiking paths. We propose QuantaSpike, a short-window spike-driven quantization framework for LLMs built around Logarithmic Ternary Integrate-and-Fire (LTIF) neurons.},
  preview       = {quantaspike.png}
}

@article{hu2026spikelite,
  abbr          = {arXiv},
  bibtex_show   = {true},
  selected      = {true},
  title         = {SpikeLite: Lightweight Spiking Neural Networks for Time-Series Forecasting},
  author        = {Hu, Bang and Lv, Changze and Li, Mingjie and Zheng, Xiaoqing and Cao, Wei and Zhang, Fan},
  year          = {2026},
  month         = {sep},
  eprint        = {2609.35097},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  doi           = {10.48550/arXiv.2609.35097},
  arxiv         = {2609.35097},
  abstract      = {Spiking neural networks offer an energy-efficient paradigm for time-series forecasting through spike-driven computation. However, recent SNN forecasters often pursue higher accuracy through increasingly complex attention mechanisms or specialized neuronal dynamics, weakening the lightweight motivation of SNNs. We introduce SpikeLite, a spiking forecasting framework built around a Frequency-Selective Spiking Encoder (FSSE) and a Sparse Spiking Channel Attention (SSCA) module.},
  preview       = {spikelite.png}
}

@article{hu2025spikestag,
  abbr          = {arXiv},
  bibtex_show   = {true},
  selected      = {true},
  title         = {SpikeSTAG: Spatial-Temporal Forecasting via GNN-SNN Collaboration},
  author        = {Hu, Bang and Lv, Changze and Li, Mingjie and Liu, Yunpeng and Zheng, Xiaoqing and Zhang, Fengzhe and Cao, Wei and Zhang, Fan},
  year          = {2025},
  month         = {aug},
  eprint        = {2508.02069},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  doi           = {10.48550/arXiv.2508.02069},
  arxiv         = {2508.02069},
  abstract      = {Spiking neural networks, inspired by the spiking behavior of biological neurons, offer a distinctive approach for capturing the complexities of temporal data. However, their potential for spatial modeling in multivariate time-series forecasting remains largely unexplored. We introduce a spiking architecture that integrates graph structural learning with spike-based temporal processing, eliminating the need for predefined graph structures.},
  preview       = {spikestag.png}
}
